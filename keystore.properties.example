# Copy to keystore.properties (git-ignored) for LOCAL release signing, or set
# the same names as environment variables / CI secrets. Release builds are
# unsigned if these are absent. Debug builds always use app/debug.keystore.
RELEASE_STORE_FILE=/absolute/path/to/release.keystore
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=passkeychain
RELEASE_KEY_PASSWORD=changeme
